# Onyx deployment. nginx proxies /api/* to the API server.
ONYX_BASE_URL=http://localhost:3001

# --- Auth: pick ONE ---
#
# Preferred on Community deployments: a dedicated eval user.
# Service-account API keys need the Business tier (POST /admin/api-key is behind
# the tier gate), but password login is never gated. Create the user once with:
#     npm run bootstrap
# It registers this account and grants it admin using an existing admin's login.
#
# Use a DEDICATED account, never your own: the setup hook wipes the calling
# user's name, role, memories and preferences.
ONYX_EVAL_USER_EMAIL=onyx-evals@example.com
ONYX_EVAL_USER_PASSWORD=

# Alternative, Business tier only. Takes precedence when set.
# ONYX_API_KEY=on_...

# Judge model: any OpenAI-compatible endpoint that serves it (the study used a gateway in
# front of the Anthropic API). The configs send apiKey "unused"; set one there if yours needs it.
JUDGE_BASE_URL=http://localhost:4000/v1
JUDGE_MODEL=claude-opus-5-5

# Langfuse ClickHouse. Langfuse v4 runs in events_only mode here, so the
# public trace API is disabled and telemetry is read from ClickHouse directly.
#   docker exec langfuse-langfuse-web-1 printenv CLICKHOUSE_PASSWORD
CLICKHOUSE_URL=http://127.0.0.1:8124
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=default
LANGFUSE_PROJECT_ID=onyx

# npm run seed reads this container's log for failed chunk-context calls, which Onyx
# otherwise hides, and its environment for the settings the manifest pins.
# Set ONYX_SKIP_DOCKER_CHECKS=1 where docker is unavailable.
ONYX_BACKGROUND_CONTAINER=onyx-background-1
# Every run reads this container's environment for manifest.onyx_api_server_env and asks
# each pinned patch's apply script whether it is in place.
ONYX_API_SERVER_CONTAINER=onyx-api_server-1

# Delete the chat sessions this run created, after the telemetry join.
# Off by default so traces stay inspectable.
ONYX_EVALS_CLEANUP=0
